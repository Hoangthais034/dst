# DST Server Configuration
# Copy this file to .env and fill in your values

# Server Architecture (amd64 or arm64)
DST_SERVER_ARCH=amd64

# Server Token (REQUIRED) - Get from https://accounts.klei.com/account/game/servers
# This is your cluster token for authentication
DST_SERVER_TOKEN=pds-g^KU_OK839zxl^NGBmMPa4/BO78n+8mMNlVgcQj5fEVkdUs9Yet57KWtA=

# Cluster Configuration
DST_SERVER_CLUSTER=YhoGay
DST_SERVER_CLUSTER_PASSWORD=yhogayvch
DST_SERVER_CLUSTER_DESCRIPTION=YhoGay Server
DST_SERVER_CLUSTER_INTENTION=cooperative
DST_SERVER_CLUSTER_LANGUAGE=en
DST_SERVER_CLUSTER_PVP=false
DST_SERVER_CLUSTER_PAUSE_WHEN_EMPTY=true
DST_SERVER_CLUSTER_AUTOSAVE=true
DST_SERVER_CLUSTER_TICK_RATE=15
DST_SERVER_CLUSTER_MAX_PLAYERS=12
DST_SERVER_CLUSTER_GAME_MODE=Endless

# Steam Group Settings (Optional)
DST_SERVER_CLUSTER_STEAM_GROUP_ID=
DST_SERVER_CLUSTER_STEAM_GROUP_ONLY=false
DST_SERVER_CLUSTER_STEAM_GROUP_ADMINS=false

# Advanced Settings
DST_SERVER_CLUSTER_ENCODE_USER_PATH=true
DST_SERVER_CLUSTER_ID=1

# Port Configuration
# Master server ports (default: 10999-11000)
DST_PORT_START=10999
DST_PORT_END=11000

# Cave server ports (default: 12346-12347)
DST_MASTER_PORT_START=12346
DST_MASTER_PORT_END=12347

