# ============================================
# CẤU HÌNH DON'T STARVE TOGETHER SERVER
# ============================================
# Copy file này thành .env và điền thông tin của bạn
# cp .env.example .env

# ============================================
# THÔNG TIN BẮT BUỘC
# ============================================
# Cluster Token - BẮT BUỘC phải có
# Lấy từ: https://accounts.klei.com/account/game/servers?game=DontStarveTogether
# Đăng nhập vào tài khoản Klei của bạn và tạo server token
DST_CLUSTER_TOKEN=your_cluster_token_here

# ============================================
# THÔNG TIN SERVER
# ============================================
# Tên server hiển thị trong danh sách
DST_NETWORK_CLUSTER_NAME=Yho host gay

# Mô tả server
DST_NETWORK_CLUSTER_DESCRIPTION=Welcome to gay server!

# Mật khẩu server (để trống nếu không muốn đặt mật khẩu)
DST_NETWORK_CLUSTER_PASSWORD=yhogayvai

# Ngôn ngữ server (en, zh, es, fr, de, it, pt, pl, ru, ko)
DST_NETWORK_CLUSTER_LANGUAGE=en

# Mục đích server (cooperative, competitive, social, madness)
DST_NETWORK_CLUSTER_INTENTION=cooperative

# ============================================
# CÀI ĐẶT GAMEPLAY
# ============================================
# Chế độ chơi (survival, endless, wilderness)
DST_GAMEPLAY_GAME_MODE=endless

# Số người chơi tối đa (1-64)
DST_GAMEPLAY_MAX_PLAYERS=12

# Bật PvP (true/false)
DST_GAMEPLAY_PVP=false

# Tạm dừng khi không có người chơi (true/false)
DST_GAMEPLAY_PAUSE_WHEN_EMPTY=true

# Bật vote (true/false)
DST_GAMEPLAY_VOTE_ENABLED=true

# ============================================
# CÀI ĐẶT MẠNG
# ============================================
# Tốc độ tick (10-60, mặc định 15)
DST_NETWORK_TICK_RATE=15

# Chỉ mạng LAN (true/false)
DST_NETWORK_LAN_ONLY_SERVER=false

# Server offline (true/false)
DST_NETWORK_OFFLINE_CLUSTER=false

# Tự động lưu (true/false)
DST_NETWORK_AUTOSAVER_ENABLED=true

# Số slot dành cho whitelist (0 = không giới hạn)
DST_NETWORK_WHITELIST_SLOTS=0

# ============================================
# CÀI ĐẶT STEAM
# ============================================
# ID nhóm Steam (0 = không sử dụng)
DST_STEAM_GROUP_ID=0

# Chỉ thành viên nhóm Steam mới vào được (true/false)
DST_STEAM_GROUP_ONLY=false

# Thành viên nhóm Steam là admin (true/false)
DST_STEAM_GROUP_ADMINS=false

# ============================================
# CÀI ĐẶT KHÁC
# ============================================
# Khu vực server (US, EU, AS, AU, NZ, BR, CN, JP, KR, IN, RU, SA)
DST_SERVER_REGION=AS

# Bật console (true/false)
DST_MISC_CONSOLE_ENABLED=true

# Bật lỗi mod (true/false)
DST_ENABLE_MOD_ERROR=false

# Bật debug print cho mod (true/false)
DST_ENABLE_MOD_DEBUG_PRINT=false

# ============================================
# CẤU HÌNH ĐƯỜNG DẪN VÀ FILE
# ============================================
# Mã hóa đường dẫn user (true/false)
DST_ACCOUNT_ENCODE_USER_PATH=true

# Đường dẫn file adminlist
DST_ADMINLIST_FILE=${DST_SERVER_DIR}/adminlist.txt

# Đường dẫn file blocklist
DST_BLOCKLIST_FILE=${DST_SERVER_DIR}/blocklist.txt

# Đường dẫn file cấu hình cluster
DST_CLUSTER_CONFIG_FILE=${DST_SERVER_DIR}/cluster.ini

# Đường dẫn file cluster token
DST_CLUSTER_TOKEN_FILE=${DST_SERVER_DIR}/cluster_token.txt

# Đường dẫn file leveldata override
DST_LEVELDATA_OVERRIDE_FILE=${DST_SHARD_DIR}/leveldataoverride.lua

# Đường dẫn file mod overrides
DST_MOD_OVERRIDES_FILE=${DST_SHARD_DIR}/modoverrides.lua

# Đường dẫn file mod settings
DST_MOD_SETTINGS_FILE=/usr/share/game/mods/modsettings.lua

# Đường dẫn file mod setup
DST_MOD_SETUP_FILE=/usr/share/game/mods/dedicated_server_mods_setup.lua

# Đường dẫn file cấu hình server
DST_SERVER_CONFIG_FILE=${DST_SHARD_DIR}/server.ini

# Đường dẫn file whitelist
DST_WHITELIST_FILE=${DST_SERVER_DIR}/whitelist.txt

# ============================================
# CẤU HÌNH SERVER VÀ SHARD
# ============================================
# Tên cluster server
DST_SERVER_CLUSTER=general

# Thư mục cấu hình server
DST_SERVER_CONF_DIR=server

# Thư mục gốc lưu trữ persistent (trong container)
DST_SERVER_PERSISTENT_STORAGE_ROOT=/var/lib/game

# Đường dẫn thư mục server (tự động tính từ các biến trên)
DST_SERVER_DIR=${DST_SERVER_PERSISTENT_STORAGE_ROOT}/${DST_SERVER_CONF_DIR}/${DST_SERVER_CLUSTER}

# IP bind cho shard
DST_SHARD_BIND_IP=0.0.0.0

# Key cluster cho shard
DST_SHARD_CLUSTER_KEY=default

# Tên shard
DST_SHARD_NAME=Master

# Đường dẫn thư mục shard (tự động tính từ các biến trên)
DST_SHARD_DIR=${DST_SERVER_DIR}/${DST_SHARD_NAME}

# Bật shard (true/false)
DST_SHARD_ENABLED=false

# ID shard
DST_SHARD_ID=

# Shard là master (true/false)
DST_SHARD_IS_MASTER=true

# IP master shard
DST_SHARD_MASTER_IP=127.0.0.1

# Port master shard
DST_SHARD_MASTER_PORT=10888

# Port server
DST_NETWORK_SERVER_PORT=10999

# ============================================
# CẤU HÌNH STEAM PORTS
# ============================================
# Port xác thực Steam
DST_STEAM_AUTHENTICATION_PORT=8767

# Port master server Steam
DST_STEAM_MASTER_SERVER_PORT=27020

# ============================================
# CẤU HÌNH MOD
# ============================================
# Bật mods cụ thể (danh sách cách nhau bởi dấu phẩy)
DST_FORCE_ENABLE_MODS=

# Raw mod overrides (JSON format)
DST_MOD_OVERRIDES_RAW=

# Setup mod collection
DST_SERVER_MOD_COLLECTION_SETUP=

# Setup mod server
DST_SERVER_MOD_SETUP=

# ============================================
# CẤU HÌNH SKIP (BỎ QUA)
# ============================================
# Bỏ qua cấu hình cluster (true/false)
DST_SKIP_CLUSTER_CONFIG=false

# Bỏ qua chown game (true/false)
DST_SKIP_GAME_CHOWN=false

# Bỏ qua nâng cấp game (true/false)
DST_SKIP_GAME_UPGRADE=false

# Bỏ qua leveldata override (true/false)
DST_SKIP_LEVELDATA_OVERRIDE=false

# Bỏ qua mod overrides (true/false)
DST_SKIP_MOD_OVERRIDES=false

# Bỏ qua mod settings (true/false)
DST_SKIP_MOD_SETTINGS=false

# Bỏ qua mod setup (true/false)
DST_SKIP_MOD_SETUP=false

# Bỏ qua cấu hình server (true/false)
DST_SKIP_SERVER_CONFIG=false

# Bỏ qua chown state (true/false)
DST_SKIP_STATE_CHOWN=false

# ============================================
# CẤU HÌNH OVERRIDE WORLD (WORLD GENERATION)
# ============================================
# Preset world
DST_OVERRIDE_PRESET=${DST_SHARD_NAME}

# Tên world
DST_OVERRIDE_NAME=

# Mô tả world
DST_OVERRIDE_DESC=

# ID world
DST_OVERRIDE_ID=

# Vị trí bắt đầu
DST_OVERRIDE_START_LOCATION=default

# Vị trí
DST_OVERRIDE_LOCATION=forest

# Chế độ layout
DST_OVERRIDE_LAYOUT_MODE=LinkNodesByKeys

# Task set
DST_OVERRIDE_TASK_SET=default

# World size
DST_OVERRIDE_WORLD_SIZE=medium

# Branching
DST_OVERRIDE_BRANCHING=default

# Loop
DST_OVERRIDE_LOOP=default

# Special event
DST_OVERRIDE_SPECIALEVENT=

# Version
DST_OVERRIDE_VERSION=4

# Level string
DST_OVERRIDE_LEVEL_STRING=false

# Hide minimap
DST_OVERRIDE_HIDEMINIMAP=false

# Has ocean
DST_OVERRIDE_HAS_OCEAN=true

# No joining islands
DST_OVERRIDE_NO_JOINING_ISLANDS=false

# No wormholes to disconnected tiles
DST_OVERRIDE_NO_WORMHOLES_TO_DISCONNECTED_TILES=false

# Keep disconnected tiles
DST_OVERRIDE_KEEP_DISCONNECTED_TILES=true

# Required prefabs
DST_OVERRIDE_REQUIRED_PREFABS=multiplayer_portal

# Required setpieces
DST_OVERRIDE_REQUIRED_SETPIECES=

# Numrandom set pieces
DST_OVERRIDE_NUMRANDOM_SET_PIECES=4

# Random set pieces
DST_OVERRIDE_RANDOM_SET_PIECES=

# Substitutes
DST_OVERRIDE_SUBSTITUTES=

# Prefabswaps start
DST_OVERRIDE_PREFABSWAPS_START=

# Max player position
DST_OVERRIDE_MAX_PLAYER_POSITION=999

# Min player position
DST_OVERRIDE_MIN_PLAYER_POSITION=0

# ============================================
# CẤU HÌNH OVERRIDE SEASONS
# ============================================
# Season start
DST_OVERRIDE_SEASON_START=autumn

# Autumn
DST_OVERRIDE_AUTUMN=default

# Winter
