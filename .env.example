# ============================================
# CẤU HÌNH DON'T STARVE TOGETHER SERVER
# ============================================
# Copy file này thành .env và điền thông tin của bạn
# cp .env.example .env

# ============================================
# THÔNG TIN BẮT BUỘC
# ============================================
# Cluster Token - BẮT BUỘC phải có
# Lấy từ: https://accounts.klei.com/account/game/servers?game=DontStarveTogether
# Đăng nhập vào tài khoản Klei của bạn và tạo server token
DST_CLUSTER_TOKEN=your_cluster_token_here

# ============================================
# THÔNG TIN SERVER
# ============================================
# Tên server hiển thị trong danh sách
DST_NETWORK_CLUSTER_NAME=Yho host gay

# Mô tả server
DST_NETWORK_CLUSTER_DESCRIPTION=Welcome to gay server!

# Mật khẩu server (để trống nếu không muốn đặt mật khẩu)
DST_NETWORK_CLUSTER_PASSWORD=yhogayvai

# Ngôn ngữ server (en, zh, es, fr, de, it, pt, pl, ru, ko)
DST_NETWORK_CLUSTER_LANGUAGE=en

# Mục đích server (cooperative, competitive, social, madness)
DST_NETWORK_CLUSTER_INTENTION=cooperative

# ============================================
# CÀI ĐẶT GAMEPLAY
# ============================================
# Chế độ chơi (survival, endless, wilderness)
DST_GAMEPLAY_GAME_MODE=endless

# Số người chơi tối đa (1-64)
DST_GAMEPLAY_MAX_PLAYERS=12

# Bật PvP (true/false)
DST_GAMEPLAY_PVP=false

# Tạm dừng khi không có người chơi (true/false)
DST_GAMEPLAY_PAUSE_WHEN_EMPTY=true

# Bật vote (true/false)
DST_GAMEPLAY_VOTE_ENABLED=true

# ============================================
# CÀI ĐẶT MẠNG
# ============================================
# Tốc độ tick (10-60, mặc định 15)
DST_NETWORK_TICK_RATE=15

# Chỉ mạng LAN (true/false)
DST_NETWORK_LAN_ONLY_SERVER=false

# Server offline (true/false)
DST_NETWORK_OFFLINE_CLUSTER=false

# Tự động lưu (true/false)
DST_NETWORK_AUTOSAVER_ENABLED=true

# Số slot dành cho whitelist (0 = không giới hạn)
DST_NETWORK_WHITELIST_SLOTS=0

# ============================================
# CÀI ĐẶT STEAM
# ============================================
# ID nhóm Steam (0 = không sử dụng)
DST_STEAM_GROUP_ID=0

# Chỉ thành viên nhóm Steam mới vào được (true/false)
DST_STEAM_GROUP_ONLY=false

# Thành viên nhóm Steam là admin (true/false)
DST_STEAM_GROUP_ADMINS=false

# ============================================
# CÀI ĐẶT KHÁC
# ============================================
# Khu vực server (US, EU, AS, AU, NZ, BR, CN, JP, KR, IN, RU, SA)
DST_SERVER_REGION=AS

# Bật console (true/false)
DST_MISC_CONSOLE_ENABLED=true

# Bật lỗi mod (true/false)
DST_ENABLE_MOD_ERROR=false

# Bật debug print cho mod (true/false)
DST_ENABLE_MOD_DEBUG_PRINT=false

